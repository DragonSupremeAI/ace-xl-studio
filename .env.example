# Local proxy (server/)
ACESTEP_API_URL=http://127.0.0.1:8001        # remote instance API endpoint (host:mapped-port)
ACESTEP_API_KEY=                              # matches ACESTEP_API_KEY on the instance
ACESTEP_UPLOAD_URL=http://127.0.0.1:8100      # upload helper (defaults to api url +8100)
ACESTUDIO_PORT=8088
ACESTUDIO_DATA_DIR=./data

# vast.ai launch (deploy/launch.sh)
ACESTEP_CONFIG_PATH=acestep-v15-xl-turbo
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-1.7B
ACESTEP_MODELS="acestep-v15-xl-turbo acestep-v15-xl-base"
HF_TOKEN=                                     # optional, private/gated models
GPU_QUERY="gpu_ram>=24 reliability>0.95 verified=true rentable=true direct_port_count>=1 geolocation!=CN"
DISK_GB=100
PROVISIONING_URL=                             # public URL to deploy/provision.sh
